/**
 * REYTER — розгортання на Cloudflare Workers
 *
 * Сайт зібраний Next.js: сторінки товарів статичні, але каталог
 * перечитується раз на хвилину — саме тому потрібен воркер,
 * а не просто тека з файлами. Публікація з адмінки доходить до
 * покупця сама, без перезбірки.
 *
 * Назва навмисно не «reyter»: в акаунті вже є проєкт Pages зі
 * старим сайтом і воркер сповіщень, і в панелі Cloudflare вони
 * лежать в одному списку — однакові назви там сплутати легко.
 *
 * Збірка:   npm run cf:build
 * Перегляд: npm run cf:preview   (локально, як у Cloudflare)
 * Викладка: npm run cf:ship
 *
 * Саме cf:ship, а не cf:deploy і не `wrangler deploy` руками.
 * Причина в двох рядках:
 *
 * • cf:deploy перед вивантаженням наповнює сховище сторінок у KV,
 *   а безкоштовний тариф має денну межу на запис. Коли межу
 *   вибрано, команда падає ще ДО вивантаження — і викладки немає
 *   зовсім.
 * • `wrangler deploy` натомість бере готову теку .open-next і не
 *   перезбирає її. Забув зібрати — вивантажив учорашній сайт, і
 *   виглядає це найгірше з можливого: викладка «успішна», а в
 *   браузері нічого нового. Так і сталося 12.08.2026, двічі.
 *
 * cf:ship робить усе по черзі: зібрати → звірити, що збірка
 * свіжа → вивантажити → спитати в живого сайту, чи він оновився.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reyter-site",
  // власний вхід: він переписує шлях для admin.* ще до Next
  "main": "worker-entry.ts",
  /* Сторож застарілої збірки. wrangler виконує це перед кожною
     своєю командою, тож повз нього не пройде жодна викладка —
     хоч якою командою її почали. Для `dev` він мовчить. */
  "build": { "command": "node tools/deploy-guard.mjs --if-deploy" },
  "compatibility_date": "2026-08-01",
  // nodejs_compat потрібен самому Next; global_fetch_strictly_public
  // забороняє воркеру ходити сам у себе в обхід мережі
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  /* Маршрути.
     Воркер бере ВЕСЬ магазинний домен і весь адмінський: магазин
     переїхав у корінь 14.08.2026, і попереднього сайту в корені
     більше немає.

     Маршрут воркера за шляхом має перевагу над кастомним доменом
     Pages, тож старий проєкт Pages лишається живим, але трафіку
     більше не бачить — його можна відключити спокійно, без
     поспіху й без вікна недоступності. */
  /* Сховище кешу сторінок. Без нього кожен запит рендериться
     наново — з двома читаннями Firestore на кожну сторінку. */
  /* Воркер має дозвіл покликати сам себе: саме так черга
     перебудовує сторінку, строк свіжості якої минув. */
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "reyter-site" }],

  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "779784e1ae67447fb44f8f3889614c3e" }
  ],

  "routes": [
    /* Увесь домен, а не лише /new: магазин переїхав у корінь
       14.08.2026. Старі адреси /new/* воркер переадресовує сам —
       див. worker-entry.ts. */
    { "pattern": "reyter.men/*", "zone_name": "reyter.men" },
    { "pattern": "www.reyter.men/*", "zone_name": "reyter.men" },
    { "pattern": "admin.reyter.men", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
