/**
 * REYTER — розгортання на Cloudflare Workers
 *
 * Сайт зібраний Next.js: сторінки товарів статичні, але каталог
 * перечитується раз на хвилину — саме тому потрібен воркер,
 * а не просто тека з файлами. Публікація з адмінки доходить до
 * покупця сама, без перезбірки.
 *
 * Назва навмисно не «reyter»: в акаунті вже є проєкт Pages зі
 * старим сайтом і воркер сповіщень, і в панелі Cloudflare вони
 * лежать в одному списку — однакові назви там сплутати легко.
 *
 * Збірка:   npm run cf:build
 * Перегляд: npm run cf:preview   (локально, як у Cloudflare)
 * Викладка: npm run cf:deploy
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reyter-site",
  // власний вхід: він переписує шлях для admin.* ще до Next
  "main": "worker-entry.ts",
  "compatibility_date": "2026-08-01",
  // nodejs_compat потрібен самому Next; global_fetch_strictly_public
  // забороняє воркеру ходити сам у себе в обхід мережі
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  /* Маршрути.
     У корені reyter.men лишається попередній сайт — його роздає
     проєкт Pages. Воркер бере лише /new* і весь адмінський домен.
     Маршрут за шляхом має перевагу над кастомним доменом Pages,
     тож обидва живуть на одному хості. */
  /* Сховище кешу сторінок. Без нього кожен запит рендериться
     наново — з двома читаннями Firestore на кожну сторінку. */
  /* Воркер має дозвіл покликати сам себе: саме так черга
     перебудовує сторінку, строк свіжості якої минув. */
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "reyter-site" }],

  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "779784e1ae67447fb44f8f3889614c3e" }
  ],

  "routes": [
    { "pattern": "reyter.men/new*", "zone_name": "reyter.men" },
    { "pattern": "www.reyter.men/new*", "zone_name": "reyter.men" },
    { "pattern": "admin.reyter.men", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
