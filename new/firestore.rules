// ============================================================
// REYTER — правила безпеки Firestore
// ------------------------------------------------------------
// Куди вставити: Firebase Console → Build → Firestore Database
// → вкладка «Rules» → замінити все на цей текст → Publish.
//
// Постійні адміністратори (можна змінити тут):
//   kostia.movchanovskyi@gmail.com
//   reyter.store1@gmail.com
// Додаткових адмінів вони додають прямо з адмінки сайту
// (створюється документ у колекції admins/{email}).
//
// Що саме тут перевіряється на СЕРВЕРІ, а не лише в браузері:
//   • знижка — існування коду, його стан, строки дії, мінімальна
//     сума й максимальний розмір;
//   • набір полів замовлення — дописати службовий прапорець або
//     підроблену дату не вийде;
//   • пошта замовлення в залогіненого покупця — лише його власна.
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    // email підтверджено (Google-вхід — завжди підтверджений).
    // Захищає від реєстрації чужого email через Email/Password.
    function verified() {
      return request.auth.token.email_verified == true;
    }

    function isFounder() {
      return signedIn() && verified() && (
        userEmail() == 'kostia.movchanovskyi@gmail.com' ||
        userEmail() == 'reyter.store1@gmail.com'
      );
    }

    function isAdmin() {
      return isFounder() || (
        signedIn() && verified() &&
        exists(/databases/$(database)/documents/admins/$(userEmail()))
      );
    }

    // Профілі покупців: власник читає і пише, адмін може читати
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Замовлення оформлюються на сайті: покупець з акаунтом створює
    // своє, гість — без uid. В обох випадках лише статус 'new'
    // і розумний розмір замовлення. Адмін бачить і керує всіма.
    // Знижка приймається лише така, яку справді дозволяє
    // існуючий увімкнений промокод. Без цієї перевірки покупець
    // міг би підставити будь-яку суму зі свого браузера.
    function promoDoc(code) {
      return get(/databases/$(database)/documents/promos/$(code)).data;
    }

    // Поля читаємо через 'in': найперші коди створювались без type
    // і без value, а звернення до відсутнього ключа в Rules — це
    // помилка обчислення, тобто ВІДМОВА в записі всього замовлення.
    function promoValue(p) {
      return ('value' in p) ? p.value : 0;
    }

    function promoIsFixed(p) {
      return ('type' in p) && p.type == 'fixed';
    }

    // Скільки максимум дозволено списати.
    //
    // Ділення цілих у Rules ВІДКИДАЄ дріб, а клієнт округлює —
    // старий сайт угору, новий униз. Тому запас в одну гривню:
    // без нього 10% від 465 грн (клієнт 47, правило 46) відхиляло
    // б усе замовлення мовчки, і покупець просто не міг би його
    // оформити. Одна гривня тут дешевша за втрачений продаж.
    function maxDiscount(code, subtotal) {
      let p = promoDoc(code);
      return promoIsFixed(p)
        ? promoValue(p)
        : subtotal * promoValue(p) / 100 + 1;
    }

    // Мінімальна сума кошика, якщо вона задана
    function promoMinTotalOk(code, subtotal) {
      let p = promoDoc(code);
      return !('minTotal' in p) || p.minTotal == 0 || subtotal >= p.minTotal;
    }

    // Ліміт використань: 0 (або поле відсутнє) — без обмежень
    function promoHasUsesLeft(code) {
      let p = promoDoc(code);
      return !('usageLimit' in p) || p.usageLimit == 0
        || (('usedCount' in p) ? p.usedCount : 0) < p.usageLimit;
    }

    function promoInDateRange(code) {
      let p = promoDoc(code);
      let today = request.time.toMillis();
      return (!('startsAt' in p) || p.startsAt == '' ||
              timestamp.value(p.startsAt + 'T00:00:00Z').toMillis() <= today)
        && (!('endsAt' in p) || p.endsAt == '' ||
              timestamp.value(p.endsAt + 'T23:59:59Z').toMillis() >= today);
    }

    function discountAllowed() {
      let d = request.resource.data;
      return d.discount == 0
        ? d.promoCode == ''
        : (
            d.promoCode is string && d.promoCode.size() > 0
            && exists(/databases/$(database)/documents/promos/$(d.promoCode))
            && promoDoc(d.promoCode).active != false
            && promoHasUsesLeft(d.promoCode)
            // строки дії перевіряються й тут, а не лише в браузері:
            // інакше вчорашній код працював би вічно
            && promoInDateRange(d.promoCode)
            && promoMinTotalOk(d.promoCode, d.subtotal)
            && d.discount <= maxDiscount(d.promoCode, d.subtotal)
          );
    }

    // Набір полів замовлення. Без нього в документ можна дописати
    // що завгодно — від службових прапорців до підробленої дати —
    // і воно потрапить в адмінку як справжнє.
    function orderKeysOk() {
      return request.resource.data.keys().hasOnly([
        'num', 'date', 'items', 'subtotal', 'discount', 'promoCode',
        'shipping', 'total', 'customer', 'message', 'status', 'uid',
        'email', 'source', 'lang', 'trackKey', 'created',
        // дописує адмінка при ручному створенні
        'createdBy', 'statusLog', 'stockApplied', 'note', 'ttn'
      ]);
    }

    // Пошта в замовленні. Залогінений покупець може вказати лише
    // свою: інакше він поклав би замовлення в чужий кабінет — воно
    // читається саме за поштою.
    function orderEmailOk() {
      let d = request.resource.data;
      return d.email is string && d.email.size() < 120
        && (!signedIn() || d.email == '' || d.email == userEmail());
    }

    function validNewOrder() {
      let d = request.resource.data;
      return d.status == 'new'
        && orderKeysOk()
        && orderEmailOk()
        && d.num is string && d.num.size() > 0 && d.num.size() < 40
        && d.total is number && d.total >= 0 && d.total < 1000000
        && d.subtotal is number && d.subtotal >= 0 && d.subtotal < 1000000
        && d.discount is number && d.discount >= 0
        // Доставка входить у суму лише тоді, коли покупець обрав
        // платити її разом із замовленням. Обрав платити у
        // відділенні — тут нуль, а число живе в тексті замовлення.
        && d.shipping is number && d.shipping >= 0 && d.shipping < 100000
        && d.total == d.subtotal - d.discount + d.shipping
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.customer is map
        && discountAllowed();
    }

    // Покупець забирає собі замовлення, яке оформив гостем на цю
    // саму пошту: змінити можна рівно поле uid і лише з порожнього
    // на свій. Чуже замовлення так не привласнити — пошта в ньому
    // має збігатися з підтвердженою поштою акаунта.
    function claimsOwnOrder() {
      return signedIn() && verified()
        && resource.data.email == userEmail()
        && resource.data.uid == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
    }

    match /orders/{orderId} {
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.uid == request.auth.uid && validNewOrder())
        || (request.resource.data.uid == null && validNewOrder());
      // Друга умова читання — щоб у кабінеті були видні й замовлення,
      // оформлені до реєстрації: у них немає uid, лише пошта
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (signedIn() && verified() && resource.data.email == userEmail());
      allow update: if isAdmin() || claimsOwnOrder();
      allow delete: if isAdmin();
    }

    // Публічне відстеження замовлення без акаунта.
    // Ідентифікатор документа — відбиток від номера замовлення
    // і телефону покупця (SHA-256), тож відкрити запис може лише
    // той, хто знає обидва. Усередині немає ні імені, ні телефону,
    // ні адреси — тільки статус, дати, сума й ТТН.
    function validTracking() {
      let d = request.resource.data;
      return d.keys().hasOnly(['num', 'date', 'status', 'total', 'items', 'ttn', 'carrier', 'city', 'log'])
        && d.num is string && d.num.size() > 0 && d.num.size() < 40
        && d.status == 'new'
        && d.total is number && d.total >= 0 && d.total < 1000000
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.log is list && d.log.size() <= 12;
    }

    match /tracking/{key} {
      allow get: if true;
      // list заборонено: інакше можна було б вивантажити всі записи
      // й читати статуси чужих замовлень без жодного ключа
      allow create: if isAdmin() || validTracking();
      allow update, delete: if isAdmin();
    }

    // Список додаткових адмінів
    match /admins/{adminEmail} {
      allow read, write: if isAdmin();
    }

    // Складські залишки: сайт читає публічно (щоб показувати
    // «Продано» / «Закінчується»), змінює лише адмін
    match /inventory/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Приходи товару
    match /restocks/{restockId} {
      allow read, write: if isAdmin();
    }

    // Дата очікуваного приходу для сайту: лише «коли зʼявиться»,
    // без кількостей і нотаток — це вже комерційна інформація.
    // Пише адмінка автоматично при роботі з приходами.
    match /restock_eta/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Підписки «повідомити, коли зʼявиться». Покупець створює
    // свою (тільки з валідними полями), читає й розсилає адмін.
    match /stock_alerts/{alertId} {
      allow create: if request.resource.data.keys().hasOnly(
          ['productId', 'productName', 'size', 'email', 'lang', 'notified', 'created'])
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productId.size() < 60
        && request.resource.data.email is string
        && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.email.size() < 120
        && request.resource.data.notified == false;
      allow read, update, delete: if isAdmin();
    }

    // Журнал руху складу
    match /stock_moves/{moveId} {
      allow read, write: if isAdmin();
    }

    // Каталог: категорії та товари — сайт читає публічно,
    // редагує лише адмін (через адмінку)
    match /catalog_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /catalog_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Опублікований каталог. Адмінка редагує чернетку
    // (catalog_categories / catalog_products), а сайт показує
    // зафіксований знімок published/catalog. Запланована версія
    // лежить у published/next і вмикається сама, щойно настає
    // її час — порівнянням часу в браузері покупця, без сервера.
    match /published/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Промокоди.
    // get — покупець може перевірити конкретний код, який знає;
    // list заборонено, тому вивантажити всі коди не вийде.
    // Персональний промокод має поле email. Прочитати його може
    // лише власник цієї пошти — тобто чужий код не спрацює навіть
    // якщо його підгледіли.
    function promoIsPublic() {
      return !('email' in resource.data) || resource.data.email == '' || resource.data.email == null;
    }

    function promoIsMine() {
      return signedIn() && verified() && resource.data.email == userEmail();
    }

    match /promos/{code} {
      allow get: if isAdmin() || promoIsPublic() || promoIsMine();
      // Запит виду where('email','==', своя_пошта) дозволений:
      // правило перевіряється для кожного документа вибірки
      allow list: if isAdmin() || promoIsMine();
      // Змінювати промокод може лише адмін — з одним винятком:
      // після оформлення замовлення браузер покупця збільшує
      // лічильник використань рівно на одиницю і більше нічого
      // не чіпає. Обнулити чи «розширити» код так неможливо,
      // а без цього ліміт не працював би взагалі.
      // Збільшити можна рівно на одиницю, рівно це поле і лише
      // поки код узагалі діє. Обнулити чи «розширити» ліміт так
      // неможливо.
      //
      // ЗАЛИШКОВИЙ РИЗИК: виклик не привʼязаний до замовлення, тож
      // той, хто знає публічний код, може крутити лічильник і
      // вичерпати його. Грошей це не дає — лише псує акцію.
      // Правильне місце для лічильника — Cloudflare Worker, який
      // і так отримує кожне замовлення; тут він лишається, поки
      // цього не зробили, бо без нього ліміт не працює зовсім.
      function onlyUsedCountBumped() {
        let before = ('usedCount' in resource.data) ? resource.data.usedCount : 0;
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['usedCount'])
          && request.resource.data.usedCount == before + 1
          && resource.data.active != false
          && (!('usageLimit' in resource.data) || resource.data.usageLimit == 0
              || before < resource.data.usageLimit);
      }

      allow create, delete: if isAdmin();
      allow update: if isAdmin() || onlyUsedCountBumped();
    }

    // Налаштування.
    // settings/public — адреса Cloudflare Worker і пошта магазину.
    // Браузер покупця має це прочитати, щоб надіслати замовлення,
    // але секретів тут немає: і ключ Resend, і токен Telegram-бота
    // лежать у змінних самого воркера.
    match /settings/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Решта налаштувань (у т.ч. старий токен бота, якщо він ще
    // не прибраний) — лише для адміністраторів.
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
