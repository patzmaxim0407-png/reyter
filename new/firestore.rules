// ============================================================
// REYTER — правила безпеки Firestore
// ------------------------------------------------------------
// Куди вставити: Firebase Console → Build → Firestore Database
// → вкладка «Rules» → замінити все на цей текст → Publish.
//
// Постійні адміністратори (можна змінити тут):
//   kostia.movchanovskyi@gmail.com
//   reyter.store1@gmail.com
// Додаткових адмінів вони додають прямо з адмінки сайту
// (створюється документ у колекції admins/{email}).
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    // email підтверджено (Google-вхід — завжди підтверджений).
    // Захищає від реєстрації чужого email через Email/Password.
    function verified() {
      return request.auth.token.email_verified == true;
    }

    function isFounder() {
      return signedIn() && verified() && (
        userEmail() == 'kostia.movchanovskyi@gmail.com' ||
        userEmail() == 'reyter.store1@gmail.com'
      );
    }

    function isAdmin() {
      return isFounder() || (
        signedIn() && verified() &&
        exists(/databases/$(database)/documents/admins/$(userEmail()))
      );
    }

    // Профілі покупців: власник читає і пише, адмін може читати
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Замовлення оформлюються на сайті: покупець з акаунтом створює
    // своє, гість — без uid. В обох випадках лише статус 'new'
    // і розумний розмір замовлення. Адмін бачить і керує всіма.
    // Знижка приймається лише така, яку справді дозволяє
    // існуючий увімкнений промокод. Без цієї перевірки покупець
    // міг би підставити будь-яку суму зі свого браузера.
    function promoDoc(code) {
      return get(/databases/$(database)/documents/promos/$(code)).data;
    }

    function maxDiscount(code, subtotal) {
      return promoDoc(code).type == 'fixed'
        ? promoDoc(code).value
        : subtotal * promoDoc(code).value / 100;
    }

    function discountAllowed() {
      let d = request.resource.data;
      return d.discount == 0
        ? d.promoCode == ''
        : (
            d.promoCode is string && d.promoCode.size() > 0
            && exists(/databases/$(database)/documents/promos/$(d.promoCode))
            && promoDoc(d.promoCode).active != false
            && d.discount <= maxDiscount(d.promoCode, d.subtotal)
          );
    }

    function validNewOrder() {
      let d = request.resource.data;
      return d.status == 'new'
        && d.total is number && d.total >= 0 && d.total < 1000000
        && d.subtotal is number && d.subtotal >= 0 && d.subtotal < 1000000
        && d.discount is number && d.discount >= 0
        && d.total == d.subtotal - d.discount
        && d.items.size() > 0 && d.items.size() <= 50
        && discountAllowed();
    }

    match /orders/{orderId} {
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.uid == request.auth.uid && validNewOrder())
        || (request.resource.data.uid == null && validNewOrder());
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Список додаткових адмінів
    match /admins/{adminEmail} {
      allow read, write: if isAdmin();
    }

    // Складські залишки: сайт читає публічно (щоб показувати
    // «Продано» / «Закінчується»), змінює лише адмін
    match /inventory/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Приходи товару
    match /restocks/{restockId} {
      allow read, write: if isAdmin();
    }

    // Журнал руху складу
    match /stock_moves/{moveId} {
      allow read, write: if isAdmin();
    }

    // Каталог: категорії та товари — сайт читає публічно,
    // редагує лише адмін (через адмінку)
    match /catalog_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /catalog_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Промокоди.
    // get — покупець може перевірити конкретний код, який знає;
    // list заборонено, тому вивантажити всі коди не вийде.
    // Персональний промокод має поле email. Прочитати його може
    // лише власник цієї пошти — тобто чужий код не спрацює навіть
    // якщо його підгледіли.
    function promoIsPublic() {
      return !('email' in resource.data) || resource.data.email == '' || resource.data.email == null;
    }

    function promoIsMine() {
      return signedIn() && verified() && resource.data.email == userEmail();
    }

    match /promos/{code} {
      allow get: if isAdmin() || promoIsPublic() || promoIsMine();
      // Запит виду where('email','==', своя_пошта) дозволений:
      // правило перевіряється для кожного документа вибірки
      allow list: if isAdmin() || promoIsMine();
      // Змінювати промокод може лише адмін. Скільки разів код
      // використано, адмінка рахує із замовлень — тому браузеру
      // покупця запис сюди не потрібен узагалі.
      allow create, update, delete: if isAdmin();
    }

    // Налаштування сповіщень (Telegram / Email).
    // Читання публічне — сповіщення надсилає браузер покупця
    // під час оформлення замовлення.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
